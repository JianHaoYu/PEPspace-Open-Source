package proxy

import (
	"fmt"
	"io"
	"time"

	quic "github.com/quic-go/quic-go"
	quicspace "github.com/quic-go/quic-go-space"
)

func HandleStreams(OutPutstream io.Writer, IncomingStream io.Reader, buf []byte, log string) (bool, error) {
	eof := false
	nr, err := IncomingStream.Read(buf)
	if err != nil {
		if err == io.EOF {
			eof = true
			return eof, nil
		} else {
			return eof, fmt.Errorf(log+" HandleStreams IncomingStream.Read: %w", err)
		}
	}
	if nr != 0 {
		nw, err := OutPutstream.Write(buf[:nr])
		if err != nil {
			return eof, (fmt.Errorf(log+" HandleStreams OutPutstream.Write: %w", err))
		}
		if nw != nr {
			return eof, (fmt.Errorf(log + " HandleStreams short write error"))
		}
		fmt.Printf("[PEP] HandleStreams Read %d bytes Write %d bytes eof: %t \n", nr, nw, eof)
	}
	return eof, nil
}

func HandleQUICOutPutStreams(PEPstream quicspace.Stream, IncomingStream quic.Stream) {
	buf := make([]byte, 1e6)
	if err := PEPstream.SetWriteDeadline(time.Time{}); err != nil {
		panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams PEPstream.SetWriteDeadline 20s: %w", err))
	}
	if err := IncomingStream.SetReadDeadline(time.Time{}); err != nil {
		panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams IncomingStream.SetReadDeadline 20s: %w", err))
	}
	n, err := io.CopyBuffer(PEPstream, IncomingStream, buf)
	if err != nil && err != io.EOF {
		panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams io.Copy(PEPstream, IncomingStream) %w", err))
	}
	fmt.Printf("[PEP] HandleStreams Read %d bytes Write %d bytes \n", n, n)

	err = PEPstream.Close()
	if err != nil {
		panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams PEPstream.Close()"))
	}
}

func HandleQUICOutPutStreams2(PEPstream quicspace.Stream, IncomingStream quic.Stream) {
	buf := make([]byte, 1e6)
	if err := PEPstream.SetWriteDeadline(time.Time{}); err != nil {
		panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams PEPstream.SetWriteDeadline 20s: %w", err))
	}
	if err := IncomingStream.SetReadDeadline(time.Time{}); err != nil {
		panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams IncomingStream.SetReadDeadline 20s: %w", err))
	}
	SumByte := 0
	for {
		eof := false
		nr, err := IncomingStream.Read(buf)
		if err != nil {
			if err == io.EOF {
				eof = true
			} else {
				panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams IncomingStream.Read(buf) %w", err))
			}
		}
		if nr != 0 {
			nw, err := PEPstream.Write(buf[:nr])
			if err != nil {
				panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams PEPstream.Write: %w", err))
			}
			if nw != nr {
				panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams short write error"))
			}
			SumByte += nr
			fmt.Printf("[PEP] HandleStreams Read %d bytes Write %d bytes eof: %t \n", SumByte, SumByte, eof)
		}

		if eof {
			err = PEPstream.Close()
			if err != nil {
				panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams PEPstream.Close()"))
			}
		}
	}
}

func HandleQUICInPutStreams(PEPstream quicspace.Stream, IncomingStream quic.Stream) {
	buf := make([]byte, 1e6)
	if err := PEPstream.SetReadDeadline(time.Time{}); err != nil {
		panic(fmt.Errorf("[PEPSender] HandleQUICInPutStreams PEPstream.SetWriteDeadline 20s: %w", err))
	}
	if err := IncomingStream.SetWriteDeadline(time.Time{}); err != nil {
		panic(fmt.Errorf("[PEPSender] HandleQUICInPutStreams IncomingStream.SetReadDeadline 20s: %w", err))
	}
	n, err := io.CopyBuffer(IncomingStream, PEPstream, buf)
	if err != nil && err != io.EOF {
		panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams io.Copy(PEPstream, IncomingStream) %w", err))
	}
	fmt.Printf("[PEP] HandleStreams Read %d bytes Write %d bytes \n", n, n)

	err = IncomingStream.Close()
	if err != nil {
		panic(fmt.Errorf("[PEPSender] HandleQUICOutPutStreams PEPstream.Close()"))
	}
}

